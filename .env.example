# Образец окружения KOTOKOD journal. Скопировать в .env и заполнить.
#
# Файл читается из КОРНЯ репозитория (config/settings/base.py: read_env), а на
# сервере тот же путь указан в EnvironmentFile= всех трёх юнитов systemd.
#
# ⚠️ .env в git не попадает (.gitignore) и не должен: здесь пароль БД, пароль
# SMTP и токен бота.

# --- Обязательное ----------------------------------------------------------

# PostgreSQL — источник истины.
DATABASE_URL=postgresql://journal:journal_dev_password@localhost:5432/journal

# Подпись сессий и одноразовых кодов. 128 hex-символов:
#   python -c "import secrets; print(secrets.token_hex(64))"
# SECRET_KEY отдельным значением обязателен в проде; ADMIN_COOKIE_SECRET
# остаётся запасным источником для dev, где своего SECRET_KEY ещё нет.
SECRET_KEY=
ADMIN_COOKIE_SECRET=

# Домены, с которых принимаются запросы. В production.py пусто = не пустит
# никого, поэтому на сервере заполнять обязательно.
ALLOWED_HOSTS=example.kotokod.ru

# Origin'ы, которым Django доверяет при проверке CSRF (со схемой). SPA и API
# отдаются с одного домена через nginx — здесь тот же домен:
CSRF_TRUSTED_ORIGINS_LIST=https://example.kotokod.ru
# Белый список для кросс-ориджин запросов. Пусто = кросс-ориджин запрещён —
# правильно, пока фронт и API на одном домене.
CORS_ORIGINS=

# --- Почта: одноразовые коды входа (Beget SMTP) -----------------------------

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Wiki (apps/knowledge): хранилище картинок и вложений -------------------

# Куда складывать загруженные файлы. Каталог ВНЕ репозитория и вне бэкапа БД.
# Локально можно не задавать — по умолчанию journal_django/media (в .gitignore).
#
# На сервере значение обязано совпадать с тремя местами, иначе картинки не
# отдадутся: alias локации /internal-media/ в nginx, ReadWritePaths в юнитах
# journal-django и journal-celery-worker, и права каталога (kotokod:www-data).
KNOWLEDGE_MEDIA_ROOT=/var/www/journal-media

# Префикс internal-локации nginx для X-Accel-Redirect: файл отдаёт nginx, а
# Django только проверяет права. ПУСТО (или не задано) → Django отдаёт файл сам
# через FileResponse — так работает локальный runserver без nginx.
KNOWLEDGE_X_ACCEL_PREFIX=/internal-media

# --- Celery и кэш -----------------------------------------------------------

# Без REDIS_URL приложение работает синхронно, на локальном кэше в памяти:
# письма уходят прямо из запроса, задачи по расписанию (уборка осиротевших
# файлов Wiki, дайджесты Telegram) не выполняются вовсе.
REDIS_URL=redis://127.0.0.1:6379/0

# --- Telegram-уведомления ---------------------------------------------------

# Токен того же бота, что крутится в kotocode-bot.
TELEGRAM_BOT_TOKEN=
# Общий чат сотрудников (-100…). Пусто → дубли уведомлений в чат не идут,
# остаётся только личка.
TELEGRAM_GENERAL_CHAT_ID=
# Общий секрет журнал ↔ бот для /api/integrations/telegram.
BOT_SERVICE_TOKEN=
# Сколько ЗАВЕРШЁННЫХ записей очереди хранить.
NOTIFICATIONS_HISTORY_LIMIT=200

# --- Необязательное ---------------------------------------------------------

# Google Sheets — только для разовых backfill-скриптов (apps/sync).
# Основному runtime не нужны.
STUDENTS_SPREADSHEET_ID=
JOURNAL_SPREADSHEET_ID=
